# --- database ---
DATABASE_URL=sqlite:///./mba_bot.db

# --- encryption ---
# Generate with: python -m mba_bot.crypto_utils
# Losing this key makes every stored customer API credential unrecoverable.
ENCRYPTION_KEY=

# --- scheduler ---
POLL_INTERVAL_SECONDS=300
TIMEFRAME=1h
OHLCV_LIMIT=200

# --- onboarding ---
TRIAL_DAYS=7
PAPER_STARTING_BALANCE=10000

# --- strategy: EMA(20/50) crossover ---
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50

# --- risk: ATR-based stop-loss + volatility filter ---
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
# crossover signals are skipped when ATR% falls below this fraction of its
# own rolling average - i.e. the market looks flat/range-bound
ATR_FLAT_THRESHOLD=0.75
ATR_ROLLING_WINDOW=50

RISK_PCT_DEFAULT=1.0
RISK_PCT_MAX=2.0
# RISK_PCT_MAX is the highest risk per trade a customer may choose (0.1 up to this value). It is clamped to 40.0 in code whatever is written here. Above 2 the dashboard asks for a
# recorded acknowledgment, from 10 it shows the setting in red and asks for a second one (docs/safety/risk_per_trade.md). The default 2.0 changes nothing.
# Total loss stop (docs/safety/risk_per_trade.md): 0 = off (default). 1 = new live entries stop when an account's equity is 50 percent or more below its
# reference equity (a fixed rule, the same for every account), until the customer resets it on the dashboard. Open trades are never touched.
# ACCOUNT_TOTAL_LOSS_STOP=0
# Small-capital pairs (docs/safety/small_capital_pairs.md): 0 = off (default). 1 = a pair whose smallest order the account's capital x leverage cap cannot meet is recorded with a reason, shown to the
# customer with the capital needed, and left out of Auto Select. Report: python -m mba_bot.pair_skip_report
# SMALL_CAPITAL_PAIRS=0
# Demo runner (docs/safety/demo_runner.md): 0 = off (default). 1 = a customer who enters separate demo keys can run the full bot on Binance Futures Demo Trading / Spot Testnet, labelled DEMO.
# DEMO_RUNNER=0
# Live RSI mean reversion (docs/safety/live_rsi.md): 0 = off (default, rsi_mr_v1 stays paper only). 1 = an opted-in live account may take RSI entries (needs RSI_MR_ENABLED, NEW_STRATEGY_GUARDS_MODE=enforce, FEE_GUARD_MARGIN > 0).
# LIVE_RSI_MR=0
# Live Donchian breakout with a trailing stop (docs/safety/live_donchian.md): 0 = off (default, donchian_breakout_v1 stays paper only). 1 = an opted-in live account may take Donchian entries (needs DONCHIAN_ENABLED,
# NEW_STRATEGY_GUARDS_MODE=enforce, FEE_GUARD_MARGIN > 0); its protective stop only moves in the favourable direction, new stop first, old one cancelled after; a failed move keeps the old stop.
# LIVE_DONCHIAN=0
# Live multi-position (docs/safety/live_multi_position.md): 0 = off (default, a live account holds one trade). 1 = an account may hold up to its own live_slots (1 to 3) trades, one per pair, Donchian then EMA then RSI,
# one new entry per cycle. LIVE_TOTAL_RISK_CAP_PCT caps the open risk across the trades (percent of the trading capital; also capped by the daily dollar limit); 0 = no percent cap.
# LIVE_MULTI_POSITION=0
# LIVE_TOTAL_RISK_CAP_PCT=3.0
# Setup advisor (docs/safety/setup_advisor.md): 0 = off (default), /api/account/advice does not exist and no screen changes. 1 = notes on Bot Settings and a short summary on the dashboard. It only informs.
# Do not turn it on until the advisor texts have had their legal review.
# SETUP_ADVISOR=0
# Admin dashboard (docs/security/admin_dashboard.md): 0 = off (default), the admin routes are not mounted (404). 1 = read-only owner dashboard. ADMIN_EMAILS (comma separated) is the only list of admins.
# Enrol the owner's authenticator on the server first (python -m mba_bot.admin_enroll). DEPLOY_COMMIT optionally sets the commit shown.
# ADMIN_DASHBOARD_ENABLED=0
# ADMIN_EMAILS=
# DEPLOY_COMMIT=
# Reporting (docs/safety/reporting.md): 0 = off (default). 1 = GET /api/reports/summary, the report on the Performance page and a daily Telegram summary that keeps live, demo and practice apart and says
# net only when the real fees of every trade are known.
# REPORTING_V2=0
# The cap on total open risk is max(MAX_TOTAL_RISK_PCT, the account's risk % x the positions it may hold), never above 100 (0 keeps meaning no cap).

# --- platform-level NON-PRODUCTION Binance keys, shared by every account's
# paper trial (see models.py docstring on TradingAccount.paper_balance for
# why this is one shared key per market type, not one per customer) ---
# Spot and Futures practice run on SEPARATE Binance systems with separate key
# registrations - a key from one does not work on the other, and none of
# them work on Mainnet. Keep both set if you have customers on both market types.
# Spot -> Binance Spot Testnet. Generate at https://testnet.binance.vision
TESTNET_SPOT_API_KEY=
TESTNET_SPOT_API_SECRET=
# Futures -> Binance Futures DEMO TRADING (demo-fapi.binance.com). Create a
# trade-only key in the API management page of your demo account at
# https://demo.binance.com . The legacy Futures Testnet
# (testnet.binancefuture.com) is no longer supported: the old
# TESTNET_FUTURES_API_KEY / TESTNET_FUTURES_API_SECRET are IGNORED (a startup
# warning is logged if they are still set) and are never used for Demo.
DEMO_FUTURES_API_KEY=
DEMO_FUTURES_API_SECRET=

# --- notifications ---
TELEGRAM_BOT_TOKEN=
# the @username of the bot above, without the @ - used to build the
# t.me/<username>?start=<token> deep link customers tap to link their account
TELEGRAM_BOT_USERNAME=
# not implemented yet - see src/mba_bot/notifications/whatsapp.py
WHATSAPP_PROVIDER_TOKEN=

# --- web API (src/mba_bot/api/) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
# the frontend's deployed URL (or http://localhost:5173 for local dev) -
# CORS only allows this origin, and Paystack redirects back to it after payment
FRONTEND_ORIGIN=http://localhost:5173
# false only for local HTTP development - keep true on anything deployed
# so the session cookie is never sent over plain HTTP
COOKIE_SECURE=true

# --- billing (Paystack, one-time lifetime payment - no subscription) ---
PAYSTACK_SECRET_KEY=
# amount in the currency's lowest unit - e.g. kobo for NGN, so 500000 = NGN 5,000
PAYSTACK_AMOUNT=
PAYSTACK_CURRENCY=NGN

# --- exchange-side protective stops (all optional, safe defaults shown) ---
# PROTECTION_MAX_ATTEMPTS=3
# PROTECTION_RETRY_DELAY_SECONDS=2
# ENTRY_RESOLVE_ATTEMPTS=5
# ENTRY_RESOLVE_DELAY_SECONDS=1
# ENTRY_UNKNOWN_VOID_AFTER_SECONDS=180
# SPOT_STOP_LIMIT_BUFFER_PCT=0.5
# PROTECTION_SOFTWARE_GRACE_PCT=0.5
# RECOVERY_INTERVAL_SECONDS=15
# STOP_LIMIT_MONITOR_INTERVAL_SECONDS=15
# single-instance guard: a second scheduler process refuses to start
# MBA_BOT_LOCK_FILE=./mba_bot.lock
# scheduler concurrency: cycles run at once, and the per-cycle watchdog (reported, never cancelled)
# MAX_CONCURRENT_CYCLES=6
# CYCLE_WATCHDOG_SECONDS=120
# Futures pair expansion (OFF by default): extra manual-only Futures pairs and the capital-based availability
# marking. Spot and Auto Select are never affected. Turn on only after validating the markets on the VPS.
# FUTURES_PAIR_EXPANSION=false
# Research telemetry (OFF by default): records each trade's decision context and a bounded decision log in two
# separate tables. Read only by offline analysis; never by the trading path. Run `alembic upgrade head` first (see docs/security/telemetry_deployment_runbook.md).
# TRADE_TELEMETRY=false
# Opportunity ledger (OFF by default; docs/safety/opportunity_ledger.md): one decision_log row per account, strategy and closed candle for every evaluation, including "no signal" with the reason and
# the deciding numbers. Observability only: it never changes an entry decision. Needs the same tables as TRADE_TELEMETRY (no new migration) but does NOT need TRADE_TELEMETRY itself.
# Read it with: python -m mba_bot.opportunity_report --hours 24
# OPPORTUNITY_LEDGER=false
# OPPORTUNITY_LEDGER_DAILY_CAP=1500
# OPPORTUNITY_LEDGER_KEEP_DAYS=30

# Registration of NEW customers (docs/commercial_readiness.md): open (default) or closed. Closed refuses a new signup with a plain message and the contact e-mail; login, existing customers, billing
# and the admin dashboard are unaffected. Any value other than "open" counts as closed (a typo never leaves registration open).
# SIGNUPS_MODE=open
# Hourly recovery of a Paystack renewal whose webhook never settled (docs/security/billing_paystack_subscriptions.md). OFF by default: it makes read-only calls with the live Paystack key.
# Needs SUBSCRIPTION_BILLING_ENABLED, PAYSTACK_SECRET_KEY and PAYSTACK_PLAN_CODE.
# PAYSTACK_RENEWAL_RECONCILE=false

# --- strategy guards (OFF by default; docs/safety/strategy_guards.md) ---
# The EMA strategy's guard mode: off | observe | enforce. The two new strategies do NOT read it (they read NEW_STRATEGY_GUARDS_MODE).
# STRATEGY_GUARDS_MODE=off
# EMA_MIN_GAP_ATR=0
# EMA_STOP_COOLDOWN_HOURS=0
# FEE_GUARD_MARGIN=0
# FEE_GUARD_FEE_BPS=5
# FEE_GUARD_SLIPPAGE_BPS=11
# FEE_GUARD_EXPECTED_MOVE_ATR=1.0
# Open positions per account. PAPER accounts only can use more than 1 (a live account is held to 1 in code and by the database); 1 to 3.
# MAX_OPEN_POSITIONS=1
# MAX_TOTAL_RISK_PCT=2.0
# STRATEGY_DAILY_LOSS_PCT=0
# STRATEGY_PAUSE_AFTER_LOSSES=0
# STRATEGY_STREAK_PAUSE_HOURS=24
# STRATEGY_EXPECTANCY_WINDOW=20
# Telegram chat for owner alerts from the strategy guards (falls back to BILLING_ALERT_CHAT_ID)
# OWNER_ALERT_CHAT_ID=

# --- multi-trade market grade (paper accounts with MAX_OPEN_POSITIONS above 1; starting values, not tuned) ---
# GRADE2_MIN_TRADES=10
# GRADE3_MIN_TRADES=20
# GRADE_EXTREME_ATR=3.0
# GRADE_DAILY_LOSS_FRACTION=0.5
# PAPER_MIN_NOTIONAL=10

# --- EMA decides on CLOSED candles only (docs/safety/ema_closed_candle.md). OFF by default: EMA still reads the forming candle, as today. ---
# On: a crossover, the flat-market filter and the crossover exit are read from closed candles only, and an EMA entry is taken only if the signal
# candle closed within EMA_ENTRY_WINDOW_MINUTES (1 to 59). Exits are not window-limited. Change it only with no live trade open.
# EMA_CLOSED_CANDLE_ONLY=false
# EMA_ENTRY_WINDOW_MINUTES=10
# --- foreign-order alarm (docs/safety/foreign_orders.md). OFF by default. LIVE accounts only. Alert-only: it never cancels, closes or blocks anything. ---
# alert = read open orders and positions on the pair universe about every FOREIGN_ORDER_CHECK_MINUTES and alert once when one is not the bot's own.
# FOREIGN_ORDER_ALARM=off   (off | alert)
# FOREIGN_ORDER_CHECK_MINUTES=15
# --- account-wide daily loss limit and Futures leverage ceiling (docs/safety/account_daily_loss.md). Both OFF by default. LIVE accounts only. ---
# Daily loss limit: the CUSTOMER sets an amount in USDT on Bot Settings (required before live trading). With ACCOUNT_DAILY_LOSS_LIMIT=true, no NEW entry for the rest of the local day once
# the account value (exchange balance plus open positions at mark) is that amount below the day-start value. Open trades keep their stops and exits. Resets at the next local midnight.
# Fails closed (unreadable equity, an invalid time zone, or no amount set blocks entries). A raise of the amount starts at the next midnight. ACCOUNT_DAILY_LOSS_PCT is no longer read.
# ACCOUNT_DAILY_LOSS_LIMIT=false
# ACCOUNT_DAY_TIMEZONE=Africa/Lagos
# Futures ceiling: refuse a new live Futures entry if the Binance leverage on the pair is above this or the margin mode is not isolated. The bot only reads both.
# FUTURES_MAX_LEVERAGE=0
# Customer leverage (docs/safety/customer_leverage.md). strict (default) = the check above, unchanged. size_cap = a high Binance number does not refuse the entry; the position
# value is capped at min(Binance leverage, the account's own number 1 to 5, default 3) x capital. Isolated margin is still required. Only takes effect with
# PROTECTION_PRECHECK_MODE=enforce, otherwise it behaves as strict.
# FUTURES_LEVERAGE_MODE=strict
# --- new strategies: PAPER ONLY IN CODE, OFF by default (docs/safety/rsi_mr_v1.md, docs/safety/donchian_breakout_v1.md) ---
# An account runs them only if the owner sets trading_accounts.extra_strategies for it in the database. They trade only when NEW_STRATEGY_GUARDS_MODE=enforce
# and FEE_GUARD_MARGIN is above 0. A paper entry is taken only if its signal candle closed within NEW_STRATEGY_ENTRY_WINDOW_MINUTES (1 to 59).
# NEW_STRATEGY_GUARDS_MODE=off
# NEW_STRATEGY_ENTRY_WINDOW_MINUTES=10
# RSI_MR_ENABLED=false
# RSI_MR_PAPER_ONLY=true
# RSI_MR_TIMEFRAME=1h
# RSI_MR_RISK_PCT=0.5
# RSI_MR_ADX_MAX=25
# RSI_MR_STOP_ATR=1.5
# RSI_MR_TARGET_ATR=1.0
# RSI_MR_TIME_STOP_CANDLES=24
# RSI_MR_PAUSE_AFTER_LOSSES=2
# RSI_MR_SPOT_FEE_BPS=10
# RSI_MR_FUTURES_FEE_BPS=5
# RSI_MR_SLIPPAGE_BPS=5
# DONCHIAN_ENABLED=false
# DONCHIAN_PAPER_ONLY=true
# DONCHIAN_TIMEFRAME=1h
# DONCHIAN_RISK_PCT=0.5
# DONCHIAN_ENTRY_PERIOD=20
# DONCHIAN_EXIT_PERIOD=10
# DONCHIAN_VOLUME_MULT=1.5
# DONCHIAN_ATR_EXTREME_MULT=3.0
# DONCHIAN_STOP_ATR=1.5
# DONCHIAN_TRAIL_ATR=2.0
# DONCHIAN_STOP_COOLDOWN_HOURS=4
# DONCHIAN_SPOT_FEE_BPS=10
# DONCHIAN_FUTURES_FEE_BPS=5
# DONCHIAN_SLIPPAGE_BPS=5

# --- single scheduler process ---
# The default is false and this repository does not change it. The OWNER should set it to true on the server: with it on, a second uvicorn worker or a
# second scheduler process refuses to start (the database also refuses a second live trade per account, but the lock is the first line of defence).
# API_SINGLE_INSTANCE_LOCK=true
