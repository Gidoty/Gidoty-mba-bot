# --- database ---
DATABASE_URL=sqlite:///./mba_bot.db

# --- encryption ---
# Generate with: python -m mba_bot.crypto_utils
# Losing this key makes every stored customer API credential unrecoverable.
ENCRYPTION_KEY=

# --- scheduler ---
POLL_INTERVAL_SECONDS=300
TIMEFRAME=1h
OHLCV_LIMIT=200

# --- onboarding ---
TRIAL_DAYS=7
PAPER_STARTING_BALANCE=10000

# --- strategy: EMA(20/50) crossover ---
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50

# --- risk: ATR-based stop-loss + volatility filter ---
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
# crossover signals are skipped when ATR% falls below this fraction of its
# own rolling average - i.e. the market looks flat/range-bound
ATR_FLAT_THRESHOLD=0.75
ATR_ROLLING_WINDOW=50

RISK_PCT_DEFAULT=1.0
RISK_PCT_MAX=2.0

# --- platform-level NON-PRODUCTION Binance keys, shared by every account's
# paper trial (see models.py docstring on TradingAccount.paper_balance for
# why this is one shared key per market type, not one per customer) ---
# Spot and Futures practice run on SEPARATE Binance systems with separate key
# registrations - a key from one does not work on the other, and none of
# them work on Mainnet. Keep both set if you have customers on both market types.
# Spot -> Binance Spot Testnet. Generate at https://testnet.binance.vision
TESTNET_SPOT_API_KEY=
TESTNET_SPOT_API_SECRET=
# Futures -> Binance Futures DEMO TRADING (demo-fapi.binance.com). Create a
# trade-only key in the API management page of your demo account at
# https://demo.binance.com . The legacy Futures Testnet
# (testnet.binancefuture.com) is no longer supported: the old
# TESTNET_FUTURES_API_KEY / TESTNET_FUTURES_API_SECRET are IGNORED (a startup
# warning is logged if they are still set) and are never used for Demo.
DEMO_FUTURES_API_KEY=
DEMO_FUTURES_API_SECRET=

# --- notifications ---
TELEGRAM_BOT_TOKEN=
# the @username of the bot above, without the @ - used to build the
# t.me/<username>?start=<token> deep link customers tap to link their account
TELEGRAM_BOT_USERNAME=
# not implemented yet - see src/mba_bot/notifications/whatsapp.py
WHATSAPP_PROVIDER_TOKEN=

# --- web API (src/mba_bot/api/) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
# the frontend's deployed URL (or http://localhost:5173 for local dev) -
# CORS only allows this origin, and Paystack redirects back to it after payment
FRONTEND_ORIGIN=http://localhost:5173
# false only for local HTTP development - keep true on anything deployed
# so the session cookie is never sent over plain HTTP
COOKIE_SECURE=true

# --- billing (Paystack, one-time lifetime payment - no subscription) ---
PAYSTACK_SECRET_KEY=
# amount in the currency's lowest unit - e.g. kobo for NGN, so 500000 = NGN 5,000
PAYSTACK_AMOUNT=
PAYSTACK_CURRENCY=NGN

# --- exchange-side protective stops (all optional, safe defaults shown) ---
# PROTECTION_MAX_ATTEMPTS=3
# PROTECTION_RETRY_DELAY_SECONDS=2
# ENTRY_RESOLVE_ATTEMPTS=5
# ENTRY_RESOLVE_DELAY_SECONDS=1
# ENTRY_UNKNOWN_VOID_AFTER_SECONDS=180
# SPOT_STOP_LIMIT_BUFFER_PCT=0.5
# PROTECTION_SOFTWARE_GRACE_PCT=0.5
# RECOVERY_INTERVAL_SECONDS=15
# STOP_LIMIT_MONITOR_INTERVAL_SECONDS=15
# single-instance guard: a second scheduler process refuses to start
# MBA_BOT_LOCK_FILE=./mba_bot.lock
# scheduler concurrency: cycles run at once, and the per-cycle watchdog (reported, never cancelled)
# MAX_CONCURRENT_CYCLES=6
# CYCLE_WATCHDOG_SECONDS=120
