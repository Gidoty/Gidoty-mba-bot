# --- database ---
DATABASE_URL=sqlite:///./mba_bot.db

# --- encryption ---
# Generate with: python -m mba_bot.crypto_utils
# Losing this key makes every stored customer API credential unrecoverable.
ENCRYPTION_KEY=

# --- scheduler ---
POLL_INTERVAL_SECONDS=300
TIMEFRAME=1h
OHLCV_LIMIT=200

# --- onboarding ---
TRIAL_DAYS=7
PAPER_STARTING_BALANCE=10000

# --- strategy: EMA(20/50) crossover ---
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50

# --- risk: ATR-based stop-loss + volatility filter ---
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
# crossover signals are skipped when ATR% falls below this fraction of its
# own rolling average - i.e. the market looks flat/range-bound
ATR_FLAT_THRESHOLD=0.75
ATR_ROLLING_WINDOW=50

RISK_PCT_DEFAULT=1.0
RISK_PCT_MAX=2.0

# --- platform-level Binance testnet key, shared by every account's 7-day
# paper trial (see models.py docstring on TradingAccount.paper_balance for
# why this is one shared key, not one per customer) ---
# Generate at https://testnet.binance.vision
TESTNET_API_KEY=
TESTNET_API_SECRET=

# --- notifications ---
TELEGRAM_BOT_TOKEN=
# not implemented yet - see src/mba_bot/notifications/whatsapp.py
WHATSAPP_PROVIDER_TOKEN=
